# T-Deck Local Configuration & Secrets (Template)
TDECK_WORKSPACE_DIRS=h:\app
TDECK_APPS_DIR=C:\TDeckApps
TDECK_SCAN_RECENT_DAYS=120
TDECK_SCAN_EXCLUDE_DIRS=t-deck,agent-skills-master,canva-plugin-upstream-20261026,harness-upstream-review-20261026,t-hub-desktop-acceptance,thub-template-validation-20261010,Tool-github

# Cloudflare R2 Credentials
R2_ENABLED=true
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET=my-storage
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_PUBLIC_DOMAIN=

